#!/usr/bin/env bash
# Pass-through to the real herdr; pretends the server is down for `pane get` while the flag exists.
if [ -n "${FAKE_HERDR_DOWN:-}" ] && [ -f "$FAKE_HERDR_DOWN" ] && [ "${1:-} ${2:-}" = "pane get" ]; then
  echo '{"error":{"code":"server_not_running","message":"down"}}' >&2; exit 1
fi
exec "$REAL_HERDR" "$@"
